{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      ".git",
      ".runtimeconfig.json",
      ".env*",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.log",
      "node_modules",
      "coverage",
      "scripts",
      "src",
      ".gitkeep",
      "**/*.test.*",
      "**/*.spec.*",
      "**/*.map",
      "vitest.config.*",
      "tsconfig*.json",
      "*.tsbuildinfo"
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/firebase-predeploy.mjs\" build",
      "node \"$PROJECT_DIR/scripts/firebase-predeploy.mjs\" functions-check"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8180
    },
    "storage": {
      "port": 9299
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "dist",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/firebase-predeploy.mjs\" build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/creator-hub{,/**}",
        "function": {
          "functionId": "creatorDocument",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creators{,/**}",
        "function": {
          "functionId": "creatorDocument",
          "region": "europe-west1"
        }
      },
      {
        "source": "/creator-profiles/**",
        "function": {
          "functionId": "creatorProfileData",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creator-directory.json",
        "function": {
          "functionId": "creatorDirectoryData",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creator-images/**",
        "function": {
          "functionId": "creatorImage",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creator-covers/**",
        "function": {
          "functionId": "creatorCover",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creator-attributions/**",
        "function": {
          "functionId": "creatorAttribution",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/spaces{,/**}",
        "function": {
          "functionId": "spaceDocument",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/space-cards/**",
        "function": {
          "functionId": "spaceCard",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "spaceSitemap",
          "region": "europe-west1",
          "pinTag": true
        }
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,s-maxage=0,must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://www.google.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' blob: https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://firebasestorage.googleapis.com https://europe-west1-virtualartplattform.cloudfunctions.net https://www.google.com https://www.gstatic.com https://www.recaptcha.net; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://www.google.com https://recaptcha.google.com https://www.recaptcha.net; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; upgrade-insecure-requests; report-to lieuva-csp; report-uri https://europe-west1-virtualartplattform.cloudfunctions.net/lieuvaCspReport"
          },
          {
            "key": "Reporting-Endpoints",
            "value": "lieuva-csp=\"https://europe-west1-virtualartplattform.cloudfunctions.net/lieuvaCspReport\""
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,s-maxage=0,must-revalidate"
          }
        ]
      }
    ]
  }
}
