{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build",
      "npm --prefix \"$RESOURCE_DIR\" run check"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "predeploy": [
      "npm run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/creators{,/**}",
        "function": {
          "functionId": "creatorDocument",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creator-profiles/**",
        "function": {
          "functionId": "creatorProfileData",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creator-images/**",
        "function": {
          "functionId": "creatorImage",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/creator-attributions/**",
        "function": {
          "functionId": "creatorAttribution",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/spaces{,/**}",
        "function": {
          "functionId": "spaceDocument",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/space-cards/**",
        "function": {
          "functionId": "spaceCard",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "spaceSitemap",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
