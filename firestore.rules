rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function ownsGalleryData(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function ownsGallery(galleryId) {
      return signedIn()
        && get(/databases/$(database)/documents/galleries/$(galleryId)).data.ownerId == request.auth.uid;
    }

    function isGalleryMember(galleryId) {
      return verifiedAccount()
        && exists(/databases/$(database)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower()))
        && (!get(/databases/$(database)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.keys().hasAny(['status'])
          || get(/databases/$(database)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.status == 'active');
    }

    function isGalleryEditor(galleryId) {
      return verifiedAccount()
        && exists(/databases/$(database)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower()))
        && (!get(/databases/$(database)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.keys().hasAny(['status'])
          || get(/databases/$(database)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.status == 'active')
        && get(/databases/$(database)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.role == 'editor';
    }

    function isLegacyGallery(data) {
      return data.schemaVersion in [1, 2];
    }

    function isActive(data) {
      return data.expiresAt > request.time
        && (!data.keys().hasAny(['lifecycleStatus']) || data.lifecycleStatus == 'active');
    }

    function canGetGallery(galleryId, data) {
      return ownsGalleryData(data) || (isActive(data) && (
        isLegacyGallery(data)
        || data.visibility in ['public', 'unlisted']
        || isGalleryMember(galleryId)
      ));
    }

    function canListGallery(data) {
      // Lifecycle is filtered in Discover for schema-v3 compatibility because
      // older active records do not yet carry the optional lifecycle field.
      // Archived public manifests remain metadata-readable, but their direct
      // document and Storage reads are denied by canGetGallery/canReadGallery.
      return data.expiresAt > request.time
        && (isLegacyGallery(data) || data.visibility == 'public');
    }

    function validPublicationWindow(data) {
      return verifiedAccount()
        && data.retention == 'account-preview'
        && data.expiresAt < request.time + duration.value(366, 'd');
    }

    function validGalleryShape(data) {
      // Artwork geometry is validated transactionally by the shared client
      // validator before publication. Keeping this rule bounded avoids the
      // Firestore expression limit for 14-artwork Forum rooms.
      return data.keys().hasAll([
          'title', 'artist', 'templateId', 'wall', 'floor', 'ceiling',
          'lighting', 'decor', 'artworks', 'coverPath', 'ownerId',
          'publishedAt', 'expiresAt', 'schemaVersion', 'visibility',
          'retention', 'accessVersion', 'exploreListed',
          'creatorProfileListed', 'revision', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'artist', 'templateId', 'wall', 'floor', 'ceiling',
          'lighting', 'decor', 'artworks', 'coverPath', 'ownerId',
          'publishedAt', 'expiresAt', 'schemaVersion', 'visibility',
          'retention', 'accessVersion', 'revision', 'updatedAt',
          'exploreListed', 'creatorProfileListed', 'discoverEligible',
          'lifecycleStatus', 'trashedAt', 'purgeAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.artist is string
        && data.artist.size() > 0
        && data.artist.size() <= 100
        && data.templateId in ['white-cube', 'nocturne', 'pavilion']
        && data.wall in [
          'chalk', 'warm', 'travertine', 'linen', 'charcoal',
          'microcement', 'limestone', 'oak-slats', 'light-concrete',
          'black-slats', 'marble-wall', 'dark-stone'
        ]
        && data.floor in [
          'concrete', 'oak', 'terrazzo', 'marble', 'black-marble',
          'walnut', 'dark-oak', 'microcement', 'slate', 'dark-concrete',
          'travertine-floor'
        ]
        && data.ceiling in ['gallery', 'warm', 'dark', 'skylight', 'vaulted']
        && data.lighting in ['daylight', 'museum', 'evening']
        && data.artworks is list
        && data.artworks.size() > 0
        && ((data.templateId == 'pavilion' && data.artworks.size() <= 14)
          || (data.templateId != 'pavilion' && data.artworks.size() <= 8))
        && data.decor is list
        && data.decor.size() <= 8
        && data.coverPath is string
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.publishedAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.schemaVersion == 3
        && data.visibility in ['public', 'unlisted', 'private']
        && data.retention in ['guest-10-days', 'account-preview']
        && data.accessVersion == 1
        && data.exploreListed is bool
        && data.creatorProfileListed is bool
        && (!data.keys().hasAny(['discoverEligible'])
          || data.discoverEligible is bool)
        && data.revision is int
        && data.revision > 0
        && data.revision <= 1000000
        && (!data.keys().hasAny(['lifecycleStatus'])
          || data.lifecycleStatus in ['active', 'archived', 'trashed'])
        && data.updatedAt is timestamp;
    }

    function validPublicationPermit(galleryId, data) {
      let permit = get(/databases/$(database)/documents/galleryPublishPermits/$(galleryId)).data;
      return permit.ownerId == request.auth.uid
        && permit.galleryId == galleryId
        && permit.visibility == data.visibility
        && permit.retention == data.retention
        && permit.expiresAt == data.expiresAt
        && permit.permitExpiresAt > request.time;
    }

    function isValidGalleryCreate(galleryId) {
      let data = request.resource.data;
      return verifiedAccount()
        && ownsGalleryData(data)
        && validGalleryShape(data)
        && data.coverPath == 'published/' + request.auth.uid + '/' + galleryId + '/cover.webp'
        && data.revision == 1
        && data.updatedAt == data.publishedAt
        && data.lifecycleStatus == 'active'
        && validPublicationPermit(galleryId, data)
        && validPublicationWindow(data);
    }

    function currentRevision(data) {
      return data.keys().hasAny(['revision']) ? data.revision : 1;
    }

    function currentVisibility(data) {
      return data.keys().hasAny(['visibility']) ? data.visibility : 'public';
    }

    function currentRetention(data) {
      return data.keys().hasAny(['retention']) ? data.retention : 'guest-10-days';
    }

    function currentAccessVersion(data) {
      return data.keys().hasAny(['accessVersion']) ? data.accessVersion : 1;
    }

    function currentExploreListed(data) {
      return data.keys().hasAny(['exploreListed']) ? data.exploreListed : true;
    }

    function currentCreatorProfileListed(data) {
      return data.keys().hasAny(['creatorProfileListed'])
        ? data.creatorProfileListed
        : true;
    }

    function preservesDiscoverEligibility(before, data) {
      return before.keys().hasAny(['discoverEligible'])
        ? data.keys().hasAny(['discoverEligible'])
          && data.discoverEligible == before.discoverEligible
        : !data.keys().hasAny(['discoverEligible']);
    }

    function isValidGalleryUpdate(galleryId) {
      let before = resource.data;
      let data = request.resource.data;
      return verifiedAccount()
        && isActive(before)
        && (ownsGalleryData(before) || isGalleryEditor(galleryId))
        && validGalleryShape(data)
        && data.ownerId == before.ownerId
        && data.templateId == before.templateId
        && data.publishedAt == before.publishedAt
        && data.expiresAt == before.expiresAt
        && data.visibility == currentVisibility(before)
        && data.retention == currentRetention(before)
        && data.accessVersion == currentAccessVersion(before)
        && data.exploreListed == currentExploreListed(before)
        && data.creatorProfileListed == currentCreatorProfileListed(before)
        && preservesDiscoverEligibility(before, data)
        && data.revision == currentRevision(before) + 1
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['lifecycleStatus']) || data.lifecycleStatus == 'active')
        && data.coverPath.matches(
          'published/' + data.ownerId + '/' + galleryId
          + '/revisions/[A-Za-z0-9_-]{1,128}/cover[.]webp'
        );
    }

    function validProfile(userId) {
      let data = request.resource.data;
      return verifiedAccount()
        && request.auth.uid == userId
        && data.keys().hasAll([
          'uid', 'displayName', 'nickname', 'schemaVersion', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'nickname', 'avatarPath',
          'schemaVersion', 'updatedAt'
        ])
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 60
        && data.nickname is string
        && data.nickname.size() <= 32
        && data.nickname.matches('[A-Za-z0-9._-]*')
        && (!data.keys().hasAny(['avatarPath'])
          || data.avatarPath == 'profiles/' + userId + '/avatar.webp')
        && data.schemaVersion == 1
        && data.updatedAt == request.time;
    }

    match /galleries/{galleryId} {
      allow get: if canGetGallery(galleryId, resource.data);
      allow list: if request.query.limit != null
        && request.query.limit <= 30
        && (canListGallery(resource.data) || ownsGalleryData(resource.data));
      allow create: if isValidGalleryCreate(galleryId);
      allow update: if isValidGalleryUpdate(galleryId);
      allow delete: if false;

      match /members/{memberEmail} {
        allow get: if ownsGallery(galleryId)
          || (verifiedAccount() && memberEmail == request.auth.token.email.lower());
        allow list: if request.query.limit != null
          && request.query.limit <= 50
          && ((verifiedAccount()
              && resource.data.email == request.auth.token.email.lower())
            || ownsGallery(galleryId));
        allow create, update, delete: if false;
      }
    }

    match /galleryInvites/{inviteId} {
      allow get: if verifiedAccount()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.email == request.auth.token.email.lower());
      allow list: if request.query.limit != null
        && request.query.limit <= 50
        && verifiedAccount()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.email == request.auth.token.email.lower());
      allow create, update, delete: if false;
    }

    match /galleryPublishPermits/{galleryId} {
      allow read, write: if false;
    }

    match /galleryPublicationQuotas/{userId} {
      allow read, write: if false;
    }

    match /profiles/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if validProfile(userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Creator identity is projected only by trusted Functions. Keeping the
    // handle index and owner mapping off the client prevents UID disclosure,
    // handle races, and accidental publication of private account fields.
    match /creatorAccountOwners/{userId} {
      allow read, write: if false;
    }

    match /creatorAccounts/{creatorId} {
      allow read, write: if false;
    }

    match /creatorAccounts/{creatorId}/posts/{postId} {
      allow read, write: if false;
    }

    match /creatorAccounts/{creatorId}/posts/{postId}/{socialCollection}/{socialId} {
      allow read, write: if false;
    }

    match /creatorProfiles/{creatorId} {
      allow read, write: if false;
    }

    match /creatorHandles/{handle} {
      allow read, write: if false;
    }

    match /creatorFollows/{followId} {
      allow read, write: if false;
    }

    match /creatorBlocks/{blockId} {
      allow read, write: if false;
    }

    match /creatorReports/{reportId} {
      allow read, write: if false;
    }

    match /creatorNotifications/{creatorId}/{document=**} {
      allow read, write: if false;
    }

    // Newsletter consent and mail delivery are written only by trusted Cloud
    // Functions. The account may read its own preference; no client can queue
    // arbitrary email or inspect delivery/rate-limit documents.
    match /newsletterSubscriptions/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /verificationMailRateLimits/{userId} {
      allow read, write: if false;
    }

    match /newsletterUnsubscribeTokens/{tokenHash} {
      allow read, write: if false;
    }

    // Trusted Functions coordinate cross-service account deletion. Clients may
    // neither inspect nor forge progress records.
    match /accountDeletionJobs/{userId} {
      allow read, write: if false;
    }

    // Read-only compatibility for schema-v1 publications that embedded art in
    // Firestore. All new schema-v3 images live in Storage.
    match /galleryArtworks/{assetId} {
      allow read: if resource.data.expiresAt > request.time;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
