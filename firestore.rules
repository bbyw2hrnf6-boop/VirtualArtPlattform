rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /galleries/{galleryId} {
      allow read: if resource.data.expiresAt > request.time;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'title', 'artist', 'templateId', 'wall', 'floor', 'ceiling', 'lighting',
          'decor', 'artworks', 'coverSrc', 'ownerId', 'publishedAt', 'expiresAt', 'schemaVersion'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.artist is string
        && request.resource.data.artist.size() <= 100
        && request.resource.data.templateId in ['white-cube', 'nocturne', 'pavilion']
        && request.resource.data.wall in ['chalk', 'warm', 'travertine', 'linen', 'charcoal']
        && request.resource.data.floor in ['concrete', 'oak', 'terrazzo', 'marble', 'black-marble', 'walnut', 'dark-oak']
        && request.resource.data.ceiling in ['gallery', 'warm', 'dark']
        && request.resource.data.lighting in ['daylight', 'museum', 'evening']
        && request.resource.data.artworks is list
        && ((request.resource.data.templateId == 'pavilion' && request.resource.data.artworks.size() <= 14)
          || (request.resource.data.templateId != 'pavilion' && request.resource.data.artworks.size() <= 8))
        && request.resource.data.decor is list
        && request.resource.data.decor.size() <= 8
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(11, 'd');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /galleryArtworks/{assetId} {
      allow read: if resource.data.expiresAt > request.time;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'galleryId', 'ownerId', 'index', 'src', 'publishedAt', 'expiresAt', 'schemaVersion'
        ])
        && request.resource.data.src is string
        && request.resource.data.src.size() < 780000
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(11, 'd');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
