rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validUpload(ownerId, galleryId, kind) {
      let permit = firestore.get(/databases/(default)/documents/galleryPublishPermits/$(galleryId)).data;
      return verifiedAccount()
        && request.auth.uid == ownerId
        && permit.ownerId == ownerId
        && permit.galleryId == galleryId
        && permit.permitExpiresAt > request.time
        && request.resource != null
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.galleryId == galleryId
        && request.resource.metadata.kind == kind
        && request.resource.metadata.schemaVersion == '3'
        && request.resource.metadata.visibility in ['public', 'unlisted', 'private']
        && request.resource.metadata.visibility == permit.visibility
        && request.resource.metadata.retention == 'account-preview'
        && request.resource.metadata.retention == permit.retention
        && request.resource.metadata.expiresAtMs.matches('[0-9]{13}')
        && timestamp.value(int(request.resource.metadata.expiresAtMs)) == permit.expiresAt
        && timestamp.value(int(request.resource.metadata.expiresAtMs)) > request.time
        && timestamp.value(int(request.resource.metadata.expiresAtMs)) < request.time + duration.value(366, 'd')
        && request.resource.contentType.matches('image/(avif|jpeg|png|webp)');
    }

    function gallery(galleryId) {
      return firestore.get(/databases/(default)/documents/galleries/$(galleryId));
    }

    function activeGallery(galleryId) {
      return gallery(galleryId).data.expiresAt > request.time
        && (!gallery(galleryId).data.keys().hasAny(['lifecycleStatus'])
          || gallery(galleryId).data.lifecycleStatus == 'active');
    }

    function galleryOwner(galleryId) {
      return signedIn() && gallery(galleryId).data.ownerId == request.auth.uid;
    }

    function galleryMember(galleryId) {
      return verifiedAccount()
        && firestore.exists(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower()))
        && (!firestore.get(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.keys().hasAny(['status'])
          || firestore.get(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.status == 'active');
    }

    function galleryEditor(galleryId) {
      return verifiedAccount()
        && firestore.exists(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower()))
        && (!firestore.get(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.keys().hasAny(['status'])
          || firestore.get(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.status == 'active')
        && firestore.get(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.role == 'editor';
    }

    function galleryVisibility(galleryId) {
      return gallery(galleryId).data.keys().hasAny(['visibility'])
        ? gallery(galleryId).data.visibility
        : 'public';
    }

    function galleryRetention(galleryId) {
      return gallery(galleryId).data.keys().hasAny(['retention'])
        ? gallery(galleryId).data.retention
        : 'guest-10-days';
    }

    function canEditGallery(galleryId) {
      return activeGallery(galleryId)
        && (galleryOwner(galleryId) || galleryEditor(galleryId));
    }

    function validRevisionUpload(ownerId, galleryId, revisionId, kind) {
      return verifiedAccount()
        && canEditGallery(galleryId)
        && gallery(galleryId).data.ownerId == ownerId
        && request.resource != null
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.galleryId == galleryId
        && request.resource.metadata.uploaderId == request.auth.uid
        && request.resource.metadata.revisionId == revisionId
        && request.resource.metadata.kind == kind
        && request.resource.metadata.schemaVersion == '3'
        && request.resource.metadata.visibility == galleryVisibility(galleryId)
        && request.resource.metadata.retention == galleryRetention(galleryId)
        && request.resource.metadata.expiresAtMs.matches('[0-9]{13}')
        && timestamp.value(int(request.resource.metadata.expiresAtMs)) > request.time
        && timestamp.value(int(request.resource.metadata.expiresAtMs)) < request.time + duration.value(366, 'd')
        && request.resource.contentType.matches('image/(avif|jpeg|png|webp)');
    }

    function canReadGallery(galleryId) {
      return galleryOwner(galleryId) || (activeGallery(galleryId) && (
        gallery(galleryId).data.schemaVersion in [1, 2]
        || gallery(galleryId).data.visibility in ['public', 'unlisted']
        || galleryMember(galleryId)
      ));
    }

    match /published/{ownerId}/{galleryId}/cover.webp {
      allow read: if canReadGallery(galleryId);
      allow create: if validUpload(ownerId, galleryId, 'cover')
        && resource == null
        && request.resource.size > 0
        && request.resource.size < 1024 * 1024;
      allow delete: if false;
      allow update: if false;
    }

    match /published/{ownerId}/{galleryId}/artworks/{fileName} {
      allow read: if canReadGallery(galleryId);
      allow create: if fileName.matches('([1-9]|1[0-4])[.]webp')
        && validUpload(ownerId, galleryId, 'artwork')
        && request.resource.metadata.index.matches('([0-9]|1[0-3])')
        && resource == null
        && request.resource.size > 0
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if false;
      allow update: if false;
    }

    match /published/{ownerId}/{galleryId}/revisions/{revisionId}/cover.webp {
      allow read: if canReadGallery(galleryId);
      allow create: if resource == null
        && validRevisionUpload(ownerId, galleryId, revisionId, 'cover')
        && request.resource.size > 0
        && request.resource.size < 1024 * 1024;
      allow delete: if false;
      allow update: if false;
    }

    match /published/{ownerId}/{galleryId}/revisions/{revisionId}/artworks/{fileName} {
      allow read: if canReadGallery(galleryId);
      allow create: if resource == null
        && fileName.matches('([1-9]|1[0-4])[.]webp')
        && validRevisionUpload(ownerId, galleryId, revisionId, 'artwork')
        && request.resource.metadata.index.matches('([0-9]|1[0-3])')
        && request.resource.size > 0
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if false;
      allow update: if false;
    }

    match /published/{ownerId}/{galleryId}/{allPaths=**} {
      allow list: if signedIn()
        && request.auth.uid == ownerId
        && galleryOwner(galleryId);
    }

    match /profiles/{ownerId}/avatar.webp {
      allow read: if signedIn() && request.auth.uid == ownerId;
      allow create, update: if verifiedAccount()
        && request.auth.uid == ownerId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/(avif|jpeg|png|webp)')
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.kind == 'avatar'
        && request.resource.metadata.schemaVersion == '1';
      allow delete: if signedIn() && request.auth.uid == ownerId;
    }
  }
}
