rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function accountDeletionStarted(userId) {
      return firestore.exists(/databases/(default)/documents/accountDeletionJobs/$(userId));
    }

    function gallery(galleryId) {
      return firestore.get(/databases/(default)/documents/galleries/$(galleryId));
    }

    function activeGallery(galleryId) {
      return gallery(galleryId).data.expiresAt > request.time
        && (!gallery(galleryId).data.keys().hasAny(['lifecycleStatus'])
          || gallery(galleryId).data.lifecycleStatus == 'active');
    }

    function galleryOwner(galleryId) {
      return signedIn() && gallery(galleryId).data.ownerId == request.auth.uid;
    }

    function galleryMember(galleryId) {
      return verifiedAccount()
        && firestore.exists(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower()))
        && (!firestore.get(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.keys().hasAny(['status'])
          || firestore.get(/databases/(default)/documents/galleries/$(galleryId)/members/$(request.auth.token.email.lower())).data.status == 'active');
    }

    function canReadGallery(galleryId) {
      return galleryOwner(galleryId) || (activeGallery(galleryId) && (
        gallery(galleryId).data.schemaVersion in [1, 2]
        || gallery(galleryId).data.visibility in ['public', 'unlisted']
        || galleryMember(galleryId)
      ));
    }

    function isCurrentCover(galleryId, path) {
      return gallery(galleryId).data.coverPath == path;
    }

    function isCurrentArtworkAt(galleryId, position, path) {
      return gallery(galleryId).data.artworks is list
        && gallery(galleryId).data.artworks.size() > position
        && gallery(galleryId).data.artworks[position].storagePath == path;
    }

    function isCurrentArtwork(galleryId, fileName, path) {
      return (fileName == '1.webp' && isCurrentArtworkAt(galleryId, 0, path))
        || (fileName == '2.webp' && isCurrentArtworkAt(galleryId, 1, path))
        || (fileName == '3.webp' && isCurrentArtworkAt(galleryId, 2, path))
        || (fileName == '4.webp' && isCurrentArtworkAt(galleryId, 3, path))
        || (fileName == '5.webp' && isCurrentArtworkAt(galleryId, 4, path))
        || (fileName == '6.webp' && isCurrentArtworkAt(galleryId, 5, path))
        || (fileName == '7.webp' && isCurrentArtworkAt(galleryId, 6, path))
        || (fileName == '8.webp' && isCurrentArtworkAt(galleryId, 7, path))
        || (fileName == '9.webp' && isCurrentArtworkAt(galleryId, 8, path))
        || (fileName == '10.webp' && isCurrentArtworkAt(galleryId, 9, path))
        || (fileName == '11.webp' && isCurrentArtworkAt(galleryId, 10, path))
        || (fileName == '12.webp' && isCurrentArtworkAt(galleryId, 11, path))
        || (fileName == '13.webp' && isCurrentArtworkAt(galleryId, 12, path))
        || (fileName == '14.webp' && isCurrentArtworkAt(galleryId, 13, path));
    }

    match /published/{ownerId}/{galleryId}/cover.webp {
      allow read: if canReadGallery(galleryId)
        && isCurrentCover(galleryId, 'published/' + ownerId + '/' + galleryId + '/cover.webp');
      allow create, update, delete: if false;
    }

    match /published/{ownerId}/{galleryId}/artworks/{fileName} {
      allow read: if canReadGallery(galleryId)
        && isCurrentArtwork(
          galleryId,
          fileName,
          'published/' + ownerId + '/' + galleryId + '/artworks/' + fileName
        );
      allow create, update, delete: if false;
    }

    match /published/{ownerId}/{galleryId}/revisions/{revisionId}/cover.webp {
      allow read: if canReadGallery(galleryId)
        && isCurrentCover(
          galleryId,
          'published/' + ownerId + '/' + galleryId + '/revisions/' + revisionId + '/cover.webp'
        );
      allow create, update, delete: if false;
    }

    match /published/{ownerId}/{galleryId}/revisions/{revisionId}/artworks/{fileName} {
      allow read: if canReadGallery(galleryId)
        && isCurrentArtwork(
          galleryId,
          fileName,
          'published/' + ownerId + '/' + galleryId + '/revisions/' + revisionId + '/artworks/' + fileName
        );
      allow create, update, delete: if false;
    }

    match /published/{ownerId}/{galleryId}/{allPaths=**} {
      allow list: if signedIn()
        && request.auth.uid == ownerId
        && galleryOwner(galleryId);
    }

    match /profiles/{ownerId}/avatar.webp {
      allow read: if signedIn() && request.auth.uid == ownerId;
      // Writes are callable-only so a durable server lease can serialize them
      // with the final account-deletion Storage drain.
      allow create, update, delete: if false;
    }
  }
}
